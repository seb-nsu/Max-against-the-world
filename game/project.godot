; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Couch Quest – Max against the worlds"
run/main_scene="res://oberflaeche/hauptmenue.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Globals="*uid://bhr8adqlkhm0x"
Cursor="*uid://c2pqh7ajiuiy0"
E="*uid://rda8wggldt5o"
R="*uid://d2wgxk7hrluu"
C="*uid://c3nxajup0vuvc"
I="*uid://ctefmy3vn313s"
D="*uid://c7l7o4tdyhblt"
A="*uid://6cbiypm0qk7h"
G="*uid://blk6nfpfiqrd2"
T="*uid://30lm6k5s368s"
Bauplan="*res://skripte/bauplan.gd"
Zustand="*res://skripte/zustand.gd"
Spielstand="*res://skripte/spielstand.gd"
Hinweise="*res://skripte/hinweise.gd"
Spiel="*res://skripte/spiel.gd"
Telemetrie="*res://skripte/telemetrie.gd"
Einstellungen="*res://skripte/einstellungen.gd"
Klang="*res://skripte/klang.gd"
Errungenschaften="*res://skripte/errungenschaften.gd"
Controller="*res://skripte/controller.gd"

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[editor_plugins]

enabled=PackedStringArray("res://addons/couch_quest_bau/plugin.cfg", "res://addons/popochiu/editor/gizmos/plugin.cfg", "res://addons/popochiu/editor/importers/plugin.cfg", "res://addons/popochiu/plugin.cfg")

